<?xml version="1.0" encoding="UTF-8"?>
<!--
  The bundle's property list. `build-app.sh` substitutes @VERSION@ and @BUILD@
  from Cargo.toml, the way `packaging/debian/control.in` is substituted.

  No `CFBundleDocumentTypes` and no type declaration. The application opens a
  folder, and a folder is not a document type a bundle can claim, so there is
  nothing to associate and a single icon.

  `LSApplicationCategoryType` is required by App Store Connect and refused at
  upload without one.

  `LSMinimumSystemVersion` is 11.0. Nothing here calls anything newer than
  the Apple Event manager and `NSFileManager`, and 11.0 is where Apple silicon
  begins, so an arm64 slice cannot claim lower whatever the floor says. The
  executable has to agree: a universal build from `build-app.sh` refuses a
  slice built for a different floor, and `MACOSX_DEPLOYMENT_TARGET=11.0` is
  what sets it.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>

	<!--
	  What the application is offered in, as against what it is written in.
	  Without this key App Store Connect lists English alone however much of
	  the bundle is German, and the per-app language picker in System
	  Settings, under Language & Region, builds its list from it, so a German
	  speaker has nothing there to choose. Translating the application does
	  not reach either of them: `po/de.po` is the
	  window's words and this is the package's claim about them.

	  The array names the catalogues `CATALOGUES` in `main.rs` names, less
	  `en-x-pseudo`, which a debug build alone carries and no package ever
	  holds.
	-->
	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
	</array>

	<key>CFBundleExecutable</key>
	<string>slipcase-query</string>
	<key>CFBundleIdentifier</key>
	<string>com.excelano.slipcase-query</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>

	<!--
	  "Slipcase Query" rather than the crate name, the same choice
	  `eframe::run_native` makes for the window title.
	-->
	<key>CFBundleName</key>
	<string>Slipcase Query</string>
	<key>CFBundleDisplayName</key>
	<string>Slipcase Query</string>

	<key>CFBundleShortVersionString</key>
	<string>@VERSION@</string>
	<!--
	  Not @VERSION@. App Store Connect deduplicates uploads by this key: it
	  must increase on every upload of a bundle, including a rejected one
	  resubmitted with nothing changed. The release version cannot do that,
	  so this is the commit count, which only rises.
	  The build number `packaging/version.sh` prints is where it comes from,
	  and that script says why.
	-->
	<key>CFBundleVersion</key>
	<string>@BUILD@</string>
	<key>CFBundleIconFile</key>
	<string>slipcase-query</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.productivity</string>
	<key>LSMinimumSystemVersion</key>
	<string>11.0</string>
	<key>NSHighResolutionCapable</key>
	<true/>

	<!--
	  Answers the export compliance question in the bundle rather than in a
	  web form, so it is asked once here instead of on every upload. Without
	  it App Store Connect marks each build "Missing Compliance" and holds it
	  out of TestFlight until somebody clicks through a dialog.

	  `false` is the accurate answer. This application implements no
	  cryptography and makes no network call, so the exemption for HTTPS does
	  not even arise. An archive is a ZIP, and `zip` is built with `deflate`
	  alone; an encrypted member is refused, not decrypted.
	-->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>

	<!--
	  **No document types, and no type declarations.** Every other desktop
	  application in this fleet opens a file and so says here what that file
	  is and that it handles it. Slipcase Query opens a *folder*: it is handed a
	  directory and asks the containers in it a question, and there is no file
	  extension in that.

	  The consequence worth knowing is that Finder has nothing to offer
	  Slipcase Query for. Declaring `public.folder` here would put it in a folder's
	  *Open With*, which is what the Linux desktop entry does with
	  `inode/directory` — and it would also make macOS deliver that folder as
	  an Apple Event rather than as `argv[1]`, which needs the one `unsafe`
	  module `src/main.rs` reserves an `allow` for. That is a decision to take
	  on its own rather than a side effect of writing this file, so until it is
	  taken the folder arrives as an argument and the window's own
	  *Open folder…* is the other way in.
	-->
</dict>
</plist>
